# ================================
# Copy this file to .env and paste your key
# Restart `npm run dev` after changing
# ================================

# OpenAI API key — required for AI features (post, comment, bio, chat)
VITE_OPENAI_API_KEY=sk-your-key-here

# Optional — leave blank to use the default OpenAI endpoint
# VITE_OPENAI_BASE_URL=https://api.openai.com/v1
